# Teatro local development defaults.
# Teatro does not load this file automatically. Export the values through your shell,
# process manager, or container environment, and never commit real secrets.

TEATRO_BIND_ADDR=127.0.0.1:4440
TEATRO_DATABASE_URL=sqlite://data/teatro.sqlite3
TEATRO_DATA_DIR=./data
TEATRO_DEFAULT_LIBRARY_ROOT=./data/roms
TEATRO_ASSET_ROOT=./data/assets
# Opt-in same-link IPv4 DNS-SD advertisement. Requires a non-loopback IPv4 listener.
TEATRO_LAN_DISCOVERY_ENABLED=false
TEATRO_DISCOVERY_NAME=Teatro
TEATRO_MAX_UPLOAD_BYTES=137438953472
TEATRO_MAX_UPLOAD_BATCH_FILES=256
TEATRO_MAX_UPLOAD_BATCH_BYTES=137438953472
TEATRO_MAX_CONCURRENT_UPLOADS=2
TEATRO_MAX_MULTIPART_TEXT_BYTES=4096
TEATRO_UPLOAD_FREE_SPACE_MARGIN_BYTES=536870912
TEATRO_UPLOAD_DISK_CHECK_INTERVAL_BYTES=67108864
TEATRO_STALE_UPLOAD_AGE_SECONDS=86400

# Temporary ZIPs generated on demand for multi-file browser downloads.
TEATRO_MAX_DOWNLOAD_ARCHIVE_FILES=256
TEATRO_MAX_DOWNLOAD_ARCHIVE_BYTES=53687091200
TEATRO_MAX_CONCURRENT_DOWNLOAD_ARCHIVES=1
TEATRO_DOWNLOAD_ARCHIVE_FREE_SPACE_MARGIN_BYTES=536870912

# GOG offline-setup importer. Disabled by default because it requires a pinned extractor.
# Source runs require an absolute path to a reviewed/pinned innoextract binary
# and its lowercase SHA-256. The Docker image auto-discovers its packaged,
# hash-manifested sidecar when both values remain empty. Optional unar/unrar
# helpers must live in one separately reviewed dedicated directory.
TEATRO_GOG_IMPORT_ENABLED=false
TEATRO_INNOEXTRACT_PATH=
TEATRO_INNOEXTRACT_SHA256=
TEATRO_GOG_IMPORT_HELPER_PATH=
TEATRO_GOG_IMPORT_TIMEOUT_SECONDS=1800
TEATRO_GOG_IMPORT_MAX_EXTRACTED_BYTES=53687091200
TEATRO_GOG_IMPORT_MAX_EXTRACTED_FILES=20000

# RomM source browse and import. Disabled by default. The base URL, username, and
# secret are deliberately NOT environment variables: they are runtime settings, so
# the secret never lives in a process environment or shell history. Configure them
# in Admin UI -> Settings -> RomM source.
TEATRO_ROMM_SOURCE_ENABLED=false
TEATRO_ROMM_SOURCE_TIMEOUT_SECONDS=30
TEATRO_ROMM_IMPORT_TIMEOUT_SECONDS=3600
# Defaults to TEATRO_MAX_UPLOAD_BYTES when unset.
TEATRO_ROMM_IMPORT_MAX_BYTES=
TEATRO_ROMM_IMPORT_MAX_FILES=64

TEATRO_LOG_FORMAT=pretty
TEATRO_AUTH_RATE_LIMIT_MAX_FAILURES=10
TEATRO_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
TEATRO_AUTH_RATE_LIMIT_LOCKOUT_SECONDS=60
TEATRO_AUTH_RATE_LIMIT_MAX_ENTRIES=10000
TEATRO_PASSWORD_CONCURRENCY=2
TEATRO_PASSWORD_QUEUE_DEPTH=16
TEATRO_PASSWORD_QUEUE_TIMEOUT_SECONDS=5
TEATRO_MAX_USERNAME_BYTES=128
TEATRO_MAX_PASSWORD_BYTES=1024
TEATRO_TOKEN_TOUCH_INTERVAL_SECONDS=300
# Exact proxy IPs trusted to supply X-Forwarded-For/X-Real-IP. Empty by default.
TEATRO_TRUSTED_PROXY_IPS=
RUST_LOG=teatro=info,tower_http=info

# Optional for non-interactive user-management CLI commands.
# TEATRO_ADMIN_PASSWORD=
# TEATRO_USER_PASSWORD=

# Optional IGDB integration. Leave credentials blank unless configured locally.
TEATRO_IGDB_CLIENT_ID=
TEATRO_IGDB_CLIENT_SECRET=
